AUTH_URL=http://localhost:3000
KEYCLOAK_ISSUER=http://localhost:8081/realms/ofoq-dev
KEYCLOAK_CLIENT_ID=ofoq-site
# At least 32 random characters. Never commit real values.
AUTH_SESSION_SECRET=
KEYCLOAK_CLIENT_SECRET=
# Encrypted server-side sessions; persistent private storage for a single-node app.
AUTH_SESSION_DIR=.cache/auth-sessions
